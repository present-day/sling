{
	"name": "@zerocool/workspace",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "bun run --filter zerocool-console dev",
		"build": "bun run build:console",
		"build:console": "bun run --filter zerocool-console build",
		"start": "bun run --filter zerocool-console start",
		"lint": "bun run --filter zerocool-console lint",
		"format": "bun run --filter zerocool-console format",
		"db:migrate": "bun run --filter zerocool-console db:migrate",
		"db:generate": "bun run --filter zerocool-console db:generate",
		"db:push": "bun run --filter zerocool-console db:push",
		"test": "bun run --filter zerocool-console test"
	},
	"trustedDependencies": ["better-sqlite3", "sharp", "unrs-resolver"]
}
